{
  "name": "starter-cli",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.11.2",
  "description": "_description_",
  "author": "lonewolfy <https://github.com/lonewolfyx>",
  "license": "MIT",
  "homepage": "https://github.com/lonewolfyx/starter-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonewolfyx/starter-cli.git"
  },
  "bugs": {
    "url": "https://github.com/lonewolfyx/starter-cli/issues"
  },
  "keywords": [],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "cli-name": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1",
    "ansis": "^4.4.0",
    "c12": "4.0.0-rc.2",
    "citty": "^0.2.2",
    "defu": "^6.1.7",
    "find-up": "^8.0.0",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@lonewolfyx/tsconfig": "^0.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "verify-git-commit": "^0.0.1",
    "vitest": "^5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "commit-msg": "npx verify-git-commit"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
